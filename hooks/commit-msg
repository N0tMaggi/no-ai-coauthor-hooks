#!/bin/sh

COMMIT_MSG_FILE="$1"
AI_PATTERN="^[[:space:]]*[Cc]o-[Aa]uthored-[Bb]y:[[:space:]]*.*(claude|anthropic|opus|sonnet|haiku|chatgpt|openai|copilot|gemini|deepseek|qwen)"

HIT=$(grep -niE "$AI_PATTERN" "$COMMIT_MSG_FILE" | head -n 1 | tr -d '\r')
[ -z "$HIT" ] && exit 0

LINE_NO=${HIT%%:*}
MATCH=$(printf '%s' "${HIT#*:}" | sed 's/^[[:space:]]*//')

# --- output helpers ------------------------------------------------------------
# Colours only on a real terminal, plain text for logs, pipes and AI agents.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    RED=$(printf '\033[31m'); BOLD_RED=$(printf '\033[1;31m'); YELLOW=$(printf '\033[1;33m')
    BLUE=$(printf '\033[34m'); CYAN=$(printf '\033[36m'); RESET=$(printf '\033[0m')
else
    RED=; BOLD_RED=; YELLOW=; BLUE=; CYAN=; RESET=
fi

# visible length in characters, not bytes
vlen() {
    n=$(printf '%s' "$1" | LC_ALL=C.UTF-8 wc -m 2>/dev/null) || n=$(printf '%s' "$1" | wc -m)
    echo $((n + 0))
}

repeat() {
    printf "%${2}s" "" | sed "s/ /$1/g"
}

BODY=""
add() {
    BODY="$BODY$1	$2
"
}

# Draws BODY in a rounded box titled $1; each BODY line is "<tag><TAB><text>":
#   H heading, L source line ("3 │ text"), C caret line ("│ ^^^ note"), _ empty, P plain
print_box() {
    title=$1
    title_len=$(vlen "$title")
    width=$((title_len + 6))
    while IFS= read -r entry; do
        [ -z "$entry" ] && continue
        w=$(( $(vlen "${entry#*	}") + 6 )) # border + 2 spaces on each side
        [ "$w" -gt "$width" ] && width=$w
    done <<EOF
$BODY
EOF
    [ "$width" -lt 80 ] && width=80

    echo ""
    printf '%s╭─ %s%s%s %s╮%s\n' "$RED" "$BOLD_RED" "$title" "$RESET$RED" "$(repeat ─ $((width - title_len - 5)))" "$RESET"
    while IFS= read -r entry; do
        [ -z "$entry" ] && continue
        tag=${entry%%	*}
        text=${entry#*	}
        [ "$tag" = "_" ] && text=""
        pad=$((width - $(vlen "$text") - 4))
        case $tag in
            H) styled="$YELLOW$text$RESET" ;;
            L) styled="$BLUE${text%%│*}│$RESET$CYAN${text#*│}$RESET" ;;
            C) styled="$BLUE${text%%│*}│$RESET$BOLD_RED${text#*│}$RESET" ;;
            *) styled=$text ;;
        esac
        printf '%s│%s  %s%s%s│%s\n' "$RED" "$RESET" "$styled" "$(repeat ' ' "$pad")" "$RED" "$RESET"
    done <<EOF
$BODY
EOF
    printf '%s╰%s╯%s\n' "$RED" "$(repeat ─ $((width - 2)))" "$RESET"
    echo ""
}

# --- message -------------------------------------------------------------------
add _
add H "Triggered by disallowed Git trailer:"
add _
add L "$(printf '%4s' "$LINE_NO") │ $MATCH"
add C "     │ $(repeat '^' "$(vlen "$MATCH")") not allowed here"
add _
add H "Policy Notice:"
add P "  This repository has an active Git hook blocking AI models and assistants"
add P "  (Claude, Anthropic, ChatGPT, GitHub Copilot, etc.) from being credited"
add P "  as authors or co-authors in commit messages."
add _
add H "Instructions for AI Agent:"
add P "  1. STOP further automated Git operations immediately. Do not attempt to bypass."
add P "  2. NOTIFY the user in your response that this Git Hook blocked the commit"
add P "     due to an AI co-author mention ($MATCH)."
add P "  3. EXPLICITLY ASK the user if they want you to remove the AI co-author"
add P "     attribution to proceed, or what they want you to do."
add P "  4. Wait for the user's explicit confirmation before retrying or modifying the commit."
add _

print_box "COMMIT REJECTED: AI Co-Author Attribution Not Allowed"
exit 1
